<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="604.0" prefWidth="800.0" spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bank.view.DashboardView">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
   <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="760.0">
      <children>
            <Label fx:id="welcomeLabel" style="-fx-font-weight: bold;" text="Welcome" />
         <Region HBox.hgrow="ALWAYS" />
         <Button minWidth="80.0" mnemonicParsing="false" onAction="#onLogoutClicked" text="Logout" />
      </children>
      <VBox.margin>
         <Insets />
         </VBox.margin>
      </HBox>
      <Label text="Your Accounts" />
      <ListView fx:id="accountList" prefHeight="132.0" prefWidth="726.0" />
      <Label text="Deposit / Withdraw (select an account first)" />
      <HBox prefHeight="54.0" prefWidth="759.0" spacing="8.0">
         <children>
            <TextField fx:id="amountField" prefHeight="39.0" prefWidth="238.0" promptText="Amount (BWP)" />
            <Button mnemonicParsing="false" onAction="#onDepositClicked" text="Deposit" />
            <Button mnemonicParsing="false" onAction="#onWithdrawClicked" text="Withdraw" />
             <Button mnemonicParsing="false" onAction="#onPayInterestClicked" text="Pay monthly interest" />
         </children>
      </HBox>
      <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold;" text="Open a new account" />
      <HBox prefHeight="65.0" prefWidth="737.0" spacing="8.0">
         <children>
            <ChoiceBox fx:id="typeBox" prefWidth="150.0" />
            <TextField fx:id="openingDepositField" promptText="Opening Deposit" />
            <Button mnemonicParsing="false" onAction="#onOpenClicked" prefHeight="33.0" prefWidth="146.0" text="Open Account" />
         </children>
      </HBox>
      <Label text="Cheque Account Details Only" />
      <HBox prefHeight="58.0" prefWidth="768.0" spacing="8.0">
         <children>
            <TextField fx:id="companyNameField" prefHeight="21.0" prefWidth="201.0" promptText="Employer (Cheque Only)" />
            <TextField fx:id="companyAddressField" prefHeight="26.0" prefWidth="210.0" promptText="Employer Address" />
         </children>
      </HBox>
       <Label fx:id="messageLabel" prefHeight="40.0" prefWidth="740.0" wrapText="true" />
   </children>
</VBox>
