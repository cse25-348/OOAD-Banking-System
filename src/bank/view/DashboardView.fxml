<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="800.0" spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bank.view.DashboardView">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox prefHeight="65.0" prefWidth="490.0" spacing="600.0">
         <children>
            <Label fx:id="welcomeLabel" text="Welcome" />
            <Button alignment="TOP_RIGHT" mnemonicParsing="false" onAction="#onLogoutClicked" text="Logout" />    
        </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <Label text="Your Accounts" />
      <ListView fx:id="accountList" prefHeight="132.0" prefWidth="726.0" />
      <Label text="Deposit / Withdraw (select an account first)" />
      <HBox prefHeight="74.0" prefWidth="713.0" spacing="8.0">
         <children>
            <TextField fx:id="amountField" prefHeight="39.0" prefWidth="238.0" promptText="Amount (BWP)" />
            <Button mnemonicParsing="false" onAction="#onDepositClicked" text="Deposit" />
            <Button fx:id="onWithdrawClicked" mnemonicParsing="false" text="Withdraw" />
         </children>
      </HBox>
      <Label text="Open a new account" />
      <HBox prefHeight="134.0" prefWidth="781.0" spacing="8.0">
         <children>
            <ChoiceBox fx:id="typeBox" prefWidth="150.0" />
            <TextField fx:id="openingDepositField" promptText="Opening Deposit" />
            <TextField fx:id="companyNameField" prefHeight="26.0" prefWidth="198.0" promptText="Employer (Cheque Only)" />
            <TextField fx:id="companyAddressField" prefHeight="26.0" prefWidth="210.0" promptText="Employer Address" />
            <Button mnemonicParsing="false" onAction="#onOpenClicked" prefHeight="33.0" prefWidth="146.0" text="Open Account" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" prefHeight="18.0" prefWidth="170.0" />
   </children>
</VBox>
